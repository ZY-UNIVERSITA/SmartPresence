@inject IHtmlLocalizer<SmartPresence.Web.SharedResource> SharedLocalizer
@inject Microsoft.Extensions.Options.IOptions<AppSettings> appSettings
@{
    Layout = "_LayoutHtml";
    var version = System.Reflection.Assembly.GetAssembly(typeof(Startup)).GetName().Version;

    var identitaCorrente = (SmartPresence.Web.Areas.IdentitaViewModel)ViewData[SmartPresence.Web.Areas.IdentitaViewModel.VIEWDATA_IDENTITACORRENTE_KEY];

    var email = identitaCorrente is not null ? identitaCorrente.EmailUtenteCorrente : null;
}
@section metas {
    @RenderSection("metas", false)
}
@section styles {
    @RenderSection("styles", false)
    <style>
        .user-profile-picture {
            width: 50px;
        }

        .onit-suites-logo {
            width: 50px;
        }

        .onit-page {
            background-color: #F2F2F2;
        }

        .onit-toastify {
            color: white;
            font-weight: 500;
        }

        .onit-toastify-info {
            background: #0dcaf0 !important;
        }

        .onit-toastify-success {
            background: #198754 !important;
        }

        .onit-toastify-warning {
            background: #ffc107 !important;
            color: black !important;
        }

        .onit-toastify-error {
            background: #dc3545 !important;
        }

    </style>
}

<div id="pageId" class="onit-page vh-100 overflow-hidden d-flex flex-column">
    <div class="onit-page-sticky-top" id="onit-page-sticky-top">
        <nav class="navbar navbar-expand-lg navbar-light bg-white onit-page-menu ">
            <div class="container-fluid">
                <a class="navbar-brand d-flex align-items-center" href="/">
                    <img class="onit-suites-logo" src="~/images/app-logo.png" alt="Application logo" />
                    <h1 class="m-0 ps-2 text-black text-center">Smart Presence</h1>
                </a>

                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav">
                        <li id="requestManagementItem" class="nav-item">
                            <a class="nav-link active text-black m-0 mx-5 fs-4 " aria-current="page" asp-area="Calendar" asp-controller="Management" asp-action="Index">
                                Request management
                                <span id="pendingRequests" class="badge bg-primary">                                    
                                    <span class="visually-hidden">pending requests</span>
                                </span>
                                
                            </a>
                        </li>
                    </ul>
                </div>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <i class="fa-solid fa-bars"></i>
                </button>
                <div class="collapse navbar-collapse flex-wrap" id="navbarSupportedContent">
                    <ul class="nav navbar-nav ms-auto onit-page-menu-user">
                        @if (identitaCorrente != null)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-black" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <img class="user-profile-picture" src="~/images/profile.svg" alt="User profile picture" />&nbsp;
                                    <span class="fs-4">@identitaCorrente.SurnameName</span>
                                </a>
                                <div class="dropdown-menu dropdown-menu-end" role="menu">
                                    <a class="dropdown-item" role="menuitem" asp-area="Profile" asp-controller="Details" asp-action="Index">Profile</a>
                                    <a class="dropdown-item" role="menuitem" href="javascript:void(0)" onclick="javascript: document.getElementById('POST_LogOut').submit()" title="@SharedLocalizer["Chiudi sessione di lavoro"]">
                                        <i class="fa-solid fa-right-from-bracket"></i>&nbsp;@SharedLocalizer["Esci"]
                                    </a>
                                    <form autocomplete="off" method="post" action="@Url.Action(MVC.Login.Logout())" id="POST_LogOut" display="none"></form>
                                </div>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
        @RenderSection("pageTitle", false)
    </div>
    @RenderSection("pageSubtitle", false)
    @RenderBody()
</div>
@section googlehead {
    @*<script async src="https://www.googletagmanager.com/gtag/js?id=UA-"></script>
    <script>
    window.dataLayer = window.dataLayer || [];
    function gtag() { dataLayer.push(arguments); }
    gtag('js', new Date());
    gtag('config', 'UA-', { 'anonymize_ip': true });    // Ricordarsi di anonimizzare per fare ricadere il cookie tra quelli tecnici ed evitare l'obbligo del banner
    </script>*@
}
@section scripts {
    <script type="text/javascript">
        @this.RenderAlertsWithToastify()

        const email = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(email))

        async function getPendingCount(email) {
            const response = await fetch(`https://localhost:7132/api/api/events_count?email=${email}`);

            if (!response.ok) {
                throw new Error("Errore nella chiamata API");
            }

            const count = await response.json();
            return count;
        }

        if (email !== null) {
            getPendingCount(email)
            .then(requestManagement => {
                if (requestManagement.isManager) {
                    document.querySelector("#pendingRequests").textContent = requestManagement.count;

                } else {
                    document.querySelector("#requestManagementItem").remove();
                }
            })
            .catch(err => {
            });
        } else {
            document.querySelector("#requestManagementItem").remove();
        }
    </script>

    @RenderSection("scripts", false)
}