@using SmartPresence.Services.Employees.Queries
@model EmployeePersonalWorkEventResponse

@{
    ViewData["title"] = "Profile";
}

@section styles {
    <style>

        .avatar-img {
            width: 150px;
            height: 150px;
            object-fit: cover;
            border-radius: 10px;
        }

        .balance-table {
            width: 100%;
        }

            .balance-table th {
                border-bottom: 2px solid #000;
                padding: .75rem;
                font-weight: 600;
                text-align: center;
            }

            .balance-table td {
                padding: .75rem;
                text-align: center;
                font-size: 1rem;
            }

                .balance-table th:first-child,
                .balance-table td:first-child {
                    text-align: left;
                }

        .card.h-100 {
            min-height: 550px;
        }

        .history-header {
            font-size: 1.8rem;
            font-weight: 700;
            color: black;
            margin-bottom: 1.5rem;
            padding-bottom: 1rem;
            border-bottom: 3px solid #333;
        }

        .history-table {
            width: 100%;
            margin-top: 1rem;
        }

            .history-table th {
                font-weight: 600;
                color: black;
                padding: 1rem;
                text-align: left;
                border-bottom: 2px solid black;
            }

            .history-table td {
                padding: 0.9rem 1rem;
                border-bottom: 1px solid #e0e0e0;
                color: black;
            }

            .history-table tbody tr:hover {
                background: #f8f9fa;
            }
    </style>
}

<main>
    <div class="container-xl py-4">
        <div class="row g-4">

            <!-- Left Panel - Employee Profile -->
            <div class="col-lg-6">
                <div class="card h-100 shadow-sm border-dark rounded-3 p-4">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <h1 class="h2 fw-bold mb-3">@Model.FullName</h1>
                            <div class="mb-2">
                                <div class="small text-uppercase fw-bold mb-1">Contract Type</div>
                                <div class="fw-medium">@Model.ContractType?.Name</div>
                            </div>
                            <div class="mb-2">
                                <div class="small text-uppercase fw-bold mb-1">Role</div>
                                <div class="fw-medium">@Model.Role?.Name</div>
                            </div>
                            <div class="row mb-2">
                                <div class="col">
                                    <div class="small text-uppercase fw-bold mb-1">Team</div>
                                    <div class="fw-medium">@Model.Team?.Name</div>
                                </div>
                                <div class="col">
                                    <div class="small text-uppercase fw-bold mb-1">Area</div>
                                    <div class="fw-medium">@Model.Area?.Name</div>
                                </div>
                            </div>
                        </div>
                        <div class="avatar-section">
                            <img src="~/images/profile.svg" alt="Profile photo" class="avatar-img" />
                        </div>
                    </div>
                    <hr class="my-3">

                    <!-- Balance Table -->
                    @if (Model.TimeOff != null)
                    {
                        <table class="balance-table">
                            <thead>
                                <tr>
                                    <th>Balance</th>
                                    <th>Used</th>
                                    <th>Accrued</th>
                                    <th>Available</th>
                                    <th>Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>Leave</td>
                                    <td>@Model.TimeOff.LeaveUsed.ToString("0.##")</td>
                                    <td>@Model.TimeOff.LeaveAccrued.ToString("0.##")</td>
                                    <td>@((Model.TimeOff.LeaveAccrued - Model.TimeOff.LeaveUsed).ToString("0.##"))</td>
                                    <td><strong>@Model.TimeOff.LeaveTotal.ToString("0.##")</strong></td>
                                </tr>
                                <tr>
                                    <td>Holiday</td>
                                    <td>@Model.TimeOff.HolidayUsed</td>
                                    <td>@Model.TimeOff.HolidayAccrued</td>
                                    <td>@(Model.TimeOff.HolidayAccrued - Model.TimeOff.HolidayUsed)</td>
                                    <td><strong>@Model.TimeOff.HolidayTotal</strong></td>
                                </tr>
                            </tbody>
                        </table>
                    }
                </div>
            </div>

            <!-- Right Panel - History -->
            <div class="col-lg-6">
                <div class="card h-100 shadow-sm border-dark rounded-3 p-4">
                    <h2 class="history-header">History</h2>

                    @if (Model.WorkEvents != null && Model.WorkEvents.Any())
                    {
                        <table class="history-table">
                            <thead>
                                <tr>
                                    <th>Type</th>
                                    <th>Begin Date</th>
                                    <th>End Date</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.WorkEvents)
                                {
                                    <tr>
                                        <td><strong>@item.WorkEventType.Name</strong></td>
                                        <td>@item.StartDate.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td>@item.EndDate.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td>@item.WorkEventStatus.Name</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p class="text-muted">Nessuno storico disponibile.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</main>