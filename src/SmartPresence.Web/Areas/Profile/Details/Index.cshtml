@using SmartPresence.Services.Employees.Queries

@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@

@model EmployeePersonalWorkEventResponse

@{
}

@section styles {
    <style>
        main {
            background-color: lightgrey;
        }
    </style>
}

<main>
    <p>Profile</p>
    <ul>
        @foreach (var item in Model.WorkEvents)
        {
            <li>
                <p>@item.StartDate</p>
                <p>@item.EndDate</p>
                <p>@item.WorkEventType.Name</p>
                <p>@item.WorkEventStatus.Name</p>
            </li>
        }
    </ul>

</main>

@section scripts {
    <script></script>
}