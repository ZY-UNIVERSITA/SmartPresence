@using SmartPresence.Services.Employees.Queries
@using SmartPresence.Services.WorkEvents.Model
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@

@model EmployeePendingWorkEventsResponse

@{
}

@section styles {
    <style>
        main {
            background-color: lightgrey;
        }
    </style>
}

<main>
    <p>Management</p>

    <ul>
        @foreach (var item in Model.ListEvents)
        {
            <li>
                <p>@item.IdEvent</p>
                <p>@item.Surname</p>
                <p>@item.Name</p>
                <p>@item.BeginDate</p>
                <p>@item.EndDate</p>
                <p>@item.Notes</p>
                @* <p>@item.Status</p> *@
                <p>@item.Type</p>
            </li>
            <form asp-controller="Management" asp-action="AcceptAllRequests" method="post">
                <select name="status">
                    @foreach(var item1 in Enum.GetValues<WorkEventStatusName>())
                    {
                        <option value="@item1">@item1.ToString()</option>
                    }
                </select>
                @Html.Hidden("listId", item.IdEvent)
                <button type="submit">Send</button>
            </form>
        }
    </ul>
    
    <form asp-controller="Management" asp-action="AcceptAllRequests" method="post">
        @Html.Hidden("listId", string.Join("-", Model.ListEvents.Select(x => x.IdEvent)))
        <button type="submit" name="status" value="@WorkEventStatusName.APPROVED">Accept all</button>
        <button type="submit" name="status" value="@WorkEventStatusName.REFUSED">Reject all</button>
    </form>
</main>

@section scripts {
    <script></script>
}