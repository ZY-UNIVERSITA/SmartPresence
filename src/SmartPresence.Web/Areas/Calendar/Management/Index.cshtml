@using SmartPresence.Services.Employees.Queries
@using SmartPresence.Services.WorkEvents.Model

@model EmployeePendingWorkEventsResponse

@{
    ViewData["title"] = "Request Management";
}

@section styles {
    <style>

        #pageId {
            overflow-y: auto !important;
        }

        .user-cell {
            font-weight: 500;
            color: #333;
        }

        .date-cell {
            white-space: nowrap;
            font-size: 0.95rem;
        }

        .notes-cell {
            color: #666;
            font-style: italic;
            max-width: 200px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .actions-cell {
            text-align: right;
            white-space: nowrap;
        }
    </style>
}

<main class="container py-4">
    <!-- Requests Table -->
    <div class="card shadow-sm">
        @if (Model.ListEvents != null && Model.ListEvents.Any())
        {
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>User</th>
                        <th>Type</th>
                        <th>Date</th>
                        <th>Notes</th>
                        <th style="text-align: right;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.ListEvents)
                    {
                        <tr data-request-id="@item.IdEvent">
                            <td class="user-cell">@item.Name @item.Surname</td>
                            <td> @item.Type </td>
                            <td class="date-cell">
                                @item.BeginDate.ToString("dd/MM/yyyy HH:mm") - @item.EndDate.ToString("dd/MM/yyyy HH:mm")
                            </td>
                            <td class="notes-cell" title="@item.Notes">
                                @(string.IsNullOrEmpty(item.Notes) ? "-" : item.Notes)
                            </td>
                            <td class="actions-cell">
                                <form asp-action="HandleSingleRequest" method="post" style="display:inline;">
                                    <input type="hidden" name="id" value="@item.IdEvent" />
                                    <input type="hidden" name="status" value="@WorkEventStatusName.APPROVED" />
                                    <button type="submit" class="btn btn-primary">
                                        Approve
                                    </button>
                                </form>

                                <form asp-action="HandleSingleRequest" method="post" style="display:inline;">
                                    <input type="hidden" name="id" value="@item.IdEvent" />
                                    <input type="hidden" name="status" value="@WorkEventStatusName.REFUSED" />
                                    <button type="submit" class="btn btn-secondary">
                                        Reject
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <!-- All Actions -->
            <div class="p-3 text-end border-top">
                <button type="button"
                        class="btn btn-primary"
                        data-bs-toggle="modal"
                        data-bs-target="#approveAllModal">
                    Approve All
                </button>

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-toggle="modal"
                        data-bs-target="#rejectAllModal">
                    Reject All
                </button>
            </div>
            <!-- Approve All Modal -->
            <div class="modal fade" id="approveAllModal" tabindex="-1" aria-labelledby="approveAllModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <form asp-action="AcceptAllRequests" method="post">
                            <div class="modal-header">
                                <h5 class="modal-title" id="approveAllModalLabel">Confirm approval</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>

                            <div class="modal-body">
                                Are you sure you want to approve
                                <strong>@Model.ListEvents.Count()</strong>
                                requests?
                            </div>

                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                    Cancel
                                </button>
                                <input type="hidden"
                                       name="listId"
                                       value="@string.Join("-", Model.ListEvents.Select(x => x.IdEvent))" />
                                <button type="submit"
                                        name="status"
                                        value="@WorkEventStatusName.APPROVED"
                                        class="btn btn-primary">
                                    Confirm
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
            <!-- Reject All Modal -->
            <div class="modal fade" id="rejectAllModal" tabindex="-1" aria-labelledby="rejectAllModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <form asp-action="AcceptAllRequests" method="post">
                            <div class="modal-header">
                                <h5 class="modal-title" id="rejectAllModalLabel">Confirm rejection</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>

                            <div class="modal-body">
                                Are you sure you want to reject
                                <strong>@Model.ListEvents.Count()</strong>
                                requests?
                            </div>

                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                    Cancel
                                </button>
                                <input type="hidden"
                                       name="listId"
                                       value="@string.Join("-", Model.ListEvents.Select(x => x.IdEvent))" />
                                <button type="submit"
                                        name="status"
                                        value="@WorkEventStatusName.REFUSED"
                                        class="btn btn-primary">
                                    Confirm
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-inbox display-3"></i>
                <h3>No Pending Requests</h3>
                <p>There are no requests awaiting approval at this time.</p>
            </div>
        }
    </div>
</main>