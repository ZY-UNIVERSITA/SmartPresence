@using SmartPresence.Services.Shared
@using SmartPresence.Services.WorkEvents.Model
@using System.Globalization

@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@

@model SmartPresence.Web.Areas.Calendar.Home.ViewModel.HomeIndexViewModel

@{
    ViewData["title"] = "Calendar";

}

@section styles {
    <style>

        .pendingRequest {
            background-image: url("/images/barre.svg");
            background-repeat: repeat-x;
        }

        .profile-picture {
            width: 40px;
        }

        .btn-outline-primary {
            color: #0249dd;
        }

        .mainTable {
            min-width: 1000px;
            table-layout: fixed;
            border-collapse: collapse;
        }

            .mainTable tbody::before {
                content: '';
                display: block;
                height: 20px;
            }

            .mainTable th:first-child,
            .mainTable td:first-child {
                /* position: sticky; */
                left: 0;
                background: #fff;
                z-index: 12;
                width: 25%;
                min-width: 100px;
            }

            .mainTable thead th {
                position: sticky;
                top: 0;
                z-index: 2;
            }

        .main-section-1 {
            margin-top: 0 !important;
        }

        .arrow {
            width: 50px;
        }

        .holiday {
            background-color: lightgrey !important;
        }

        .remote-tab-table {
            table-layout: fixed;
        }
    </style>
}

<main id="app" class="container-fluid p-3 bg-light">

    @* Camio del periodo *@
    <partial name="_PartialPeriod" model="Model"></partial>

    @* Sezione dei filtri *@
    @* g3: spaziatura tra colonne *@
    <section class="row g-3 px-5 main-section-1" role="toolbar" aria-labelledby="calendar-toolbar">
        <header>
            <h2 id="calendar-toolbar" class="visually-hidden">Calendar toolbar</h2>
        </header>

        @* Filtro per team *@
        @*
            col-12: occupa 12 colonne ovvero tutta la riga da mobile
            col-md-2: occupa 2 colonne da tablet in su
        *@
        <section class="col-12 col-md-2">
            <form>
                <label for="team-select" class="form-label">Team filter</label>
                <select name="teams" class="form-select" id="team-select" v-model="filterTeam">
                    @if (Model is not null)
                    {
                        <option value="None">None</option>
                        @foreach (var team in Model.TeamList)
                        {
                            <option value="@team">@team</option>
                        }
                    }
                </select>
            </form>
        </section>

        @* Filtro per tipo di evento *@
        <section class="col-12 col-md-2 mb-3">
            <form>
                <label for="event-type-select" class="form-label">Event filter</label>
                <select name="eventsType" class="form-select" id="event-type-select" v-model="filterEventType">
                    @if (Model is not null)
                    {
                        <option value="None">None</option>
                        @foreach (var eventType in Model.EventTypeList)
                        {
                            <option value="@eventType">@eventType</option>
                        }
                    }
                </select>
            </form>
        </section>

        @* Filtro per resettare tutti i filtri *@
        @*
            col-1: singola colonna da mobile
            d-flex: permette di usare display flex e le seguenti opzioni
                align-items-md-end: in versione tablet e superiore, permette di mettere gli elementi allineati verticalmente in basso
        *@
        <section class="col-1 d-flex align-items-md-end mb-3">
            <form>
                <button type="button" class="btn btn-secondary" v-on:click="resetFilters" aria-label="Reset all filters">
                    Reset
                </button>
            </form>
        </section>

        @* Selettore vista calendario con apertura di una modale di Bootstrap*@
        @*
            col-11: occupa 11 colonne su mobile
            col-md-7: ne occupa 7 su table o superiore
            d-flex: permette di usare flex con:
                align-items-md-end: allinea gli elementi in basso su table o superiore
                justify-content-end: allinea sempre gli elementi a destra
        *@
        <section class="col-11 col-md-7 d-flex align-items-md-end justify-content-end mb-3">
            <form asp-controller="Home" asp-action="Index" method="get">
                <fieldset id="seleziona-vista-calendario">
                    <legend class="visually-hidden">Select calendar View</legend>
                    <div class="btn-group" role="radiogroup">
                        <input type="radio" class="btn-check" name="calendarView" id="week" value="WEEK" autocomplete="off"
                               @(Model.CalendarViewFilter.Equals(CalendarViewName.WEEK) ? "checked" : "") onchange="this.form.submit()">
                        <label class="btn btn-outline-primary align-items-center justify-content-center" for="week">Week</label>

                        <input type="radio" class="btn-check" name="calendarView" id="month" value="MONTH" autocomplete="off"
                               @(Model.CalendarViewFilter.Equals(CalendarViewName.MONTH) ? "checked" : "") onchange="this.form.submit()">
                        <label class="btn btn-outline-primary align-items-center justify-content-center" for="month">Month</label>

                        <input type="radio" class="btn-check" name="calendarView" id="custom" value="CUSTOM" autocomplete="off"
                               @(Model.CalendarViewFilter.Equals(CalendarViewName.CUSTOM) ? "checked" : "")>
                        <label class="btn btn-outline-primary align-items-center justify-content-center" for="custom" data-bs-toggle="modal" data-bs-target="#date_form">
                            @if (Model.CalendarViewFilter.Equals(CalendarViewName.CUSTOM))
                            {
                                <span>{{ formatDate(employeeInfo.BeginDate) }} - {{ formatDate(employeeInfo.EndDate) }}</span>
                            }
                            else
                            {
                                <span>Period</span>
                            }
                        </label>
                    </div>
                </fieldset>
            </form>

            @* Modale di Bootstrap per la scelta del periodo
                https://getbootstrap.com/docs/5.0/components/modal/
            *@
            <section class="modal fade" id="date_form" tabindex="-1" aria-labelledby="dateModalLabel" aria-hidden="true">
                <section class="modal-dialog">
                    <section class="modal-content">
                        <form asp-controller="Home" asp-action="Index" method="get" aria-label="Select period between two dates">
                            <header class="modal-header">
                                <p class="form-label">Date range</p>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close modal"></button>
                            </header>
                            <section class="modal-body">
                                <fieldset>
                                    <legend class="visually-hidden">Date range</legend>
                                    <p>
                                        <label for="start" class="form-label">Start date</label>
                                        <input type="date" id="start" name="BeginDateString" class="form-control">
                                    </p>
                                    <p>
                                        <label for="end" class="form-label">End date</label>
                                        <input type="date" id="end" name="EndDateString" class="form-control">
                                    </p>

                                    <input type="hidden" name="calendarView" value="CUSTOM">
                                </fieldset>
                            </section>
                            <footer class="modal-footer">
                                <button type="submit" class="btn btn-primary">Submit</button>
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                            </footer>
                        </form>
                    </section>
                </section>
            </section>
        </section>
    </section>

    @* Calendario principale *@
    <section class="px-5 py-3 table-responsive calendar-section main-section-2">
        <table class="mainTable table table-bordered table-hover shadow">
            <thead class="">
                <tr class="text-center align-middle">
                    <th>
                        <input class="form-control" type="search" id="names" name="Names" aria-label="Search by surname and/or name"
                               v-model="filter" placeholder="Search by surname and/or name..." />
                    </th>
                    @foreach (var day in Model.Calendar)
                    {
                        <th id="@day.Date" scope="col" class="@day.Holiday.ToString().ToLower()">
                            <p class="m-0 fw-normal">@day.DayOfWeek</p>
                            <p class="m-0">@day.NumberOfDay</p>
                        </th>
                    }
                </tr>
            </thead>
            <tbody>
                <tr v-for="employee in filteredList" :key="employee.Id">
                    @* Prima colonna dei dipendenti, gestito come thead *@
                    <th scope="row" :id="employeeInfo.IdEmployee === employee.Id ? 'actualUser' : null" class="align-middle">
                        <img src="~/images/profile.svg"
                             alt="Profile photo"
                             class="rounded-circle me-3 profile-picture" />
                        <span>{{ `${employee.Surname} ${employee.Name}` }}</span>
                    </th>

                    @* Tutte le altre celle rappresentano invece potenziali eventi *@
                    @* Cicla sulla lista degli eventi *@
                    <template v-for="(dayEvents, index) in employee.Events" :key="`${employee.Id}-${dayEvents.Date}`">

                        @* Ogni evento, viene identificato da una data di inizio, se per quello specifico giorno ci sono eventi da visualizzare allora li visualizza *@
                        <template v-if="Array.isArray(dayEvents.ListEvents) && dayEvents.ListEvents.length > 0">
                            <td :id="employeeInfo.IdEmployee === employee.Id ? accumulateDays[index] : null" :colspan="dayEvents.Days"
                                :class="[ 'text-center', 'align-middle', getBackgroundColor(dayEvents.ListEvents) ]"
                                v-on:click="employeeInfo.IdEmployee === employee.Id && dayEvents.CanAddRequest ? openOffCanvas($event) : null"> 

                                @* Ogni evento quindi ogni giorno, potrebbe avere più eventi che accadono per quel giorno, es. leave e remote insieme *@
                                @* Cicla sui singoli eventi del giorno *@
                                <template v-for="singleEvent in dayEvents.ListEvents" :key=`${employee.Id}-${dayEvents.Date}-${singleEvent.Id}`>

                                    @* Se è un holiday o un remote oppure è un leave da visualizzare come singola lettera, mostra il nome o la sigla dell'evento*@
                                    <template v-if="singleEvent.Type !== 'LEAVE' && singleEvent.Type !== 'L'">
                                        <p :class="[ 'm-0', 'fw-bold', getTextColor(singleEvent) ]">{{ singleEvent.Type }}</p>
                                    </template>

                                    @* Se è un holiday o un remote oppure è un leave da visualizzare come singola lettera, mostra il nome o la sigla dell'evento*@
                                    @* Viene aggiunto un tooltip per visualizzare l'orario del permesso quando lo spazio in lunghezza non è sufficiente *@
                                    <template v-else-if="singleEvent.Type.length === 1">
                                        <p :class="[ 'm-0', 'fw-bold', getTextColor(singleEvent) ]"
                                           data-bs-toggle="tooltip"
                                           data-bs-placement="right"
                                           :title="singleEvent.DateRange">
                                            {{ singleEvent.Type }}
                                        </p>
                                    </template>

                                    @* Se invece è un leave e non c'è da visualizzare in singola lettera, visualizza l'orario *@
                                    <template v-else>
                                        <p :class="[ 'm-0', 'fw-bold', getTextColor(singleEvent) ]">{{ singleEvent.DateRange }}</p>
                                    </template>
                                </template>
                            </td>
                        </template>

                        @* Se non ci sono eventi da visualizzare, crea una cella e passa alla prossima *@
                        <template v-else>
                            <td :id="employeeInfo.IdEmployee === employee.Id ? accumulateDays[index] : null"
                                v-on:click="employeeInfo.IdEmployee === employee.Id && dayEvents.CanAddRequest ? openOffCanvas($event) : null">
                            </td>
                        </template>
                    </template>
                </tr>
            </tbody>
        </table>
    </section>


    @* Off canvas di Bootstrap per nuova richiesta
        https://getbootstrap.com/docs/5.0/components/offcanvas/
    *@
    <aside class="offcanvas offcanvas-start" data-bs-scroll="true" data-bs-backdrop="false" tabindex="-1" id="offcanvasScrolling" aria-labelledby="offcanvasScrollingLabel" ref="offcanvas">
        <header class="offcanvas-header">
            <h2 class="offcanvas-title" id="offcanvasScrollingLabel">New request</h2>
            <input type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close" />
        </header>

        @* Dispone gli elementi in singola colonna quindi ogni elemento sarà su singola riga *@
        <section class="offcanvas-body d-flex flex-column">

            <header>
                <ul class="nav nav-tabs" id="myTab" role="tablist">
                    <li class="nav-item" role="presentation">
                        <input class="nav-link active" id="HolidayTab" data-bs-toggle="tab" data-bs-target="#HolidayTabContent" type="button" role="tab" aria-controls="HolidayTab" aria-selected="true" value="Holiday/Leave" />
                    </li>
                    <li class="nav-item" role="presentation">
                        <input class="nav-link" id="RemoteTab" data-bs-toggle="tab" data-bs-target="#RemoteTabContent" type="button" role="tab" aria-controls="RemoteTab" aria-selected="false" value="Remote" />
                    </li>
                </ul>
            </header>

            @* Flex-grow-1: occupa tutto lo spazio disponibile *@
            <section class="tab-content flex-grow-1" id="myTabContent">

                @* h-100 per occupare tutto lo spazio della seciton *@
                <section class="tab-pane fade show active h-100" id="HolidayTabContent" role="tabpanel">

                    @* Wrapper necessario per usare Flexbox dentro il tab-pane senza rompere l'animazione *@
                    @* h-100 assicura che occupi tutta l'altezza. Se il contenuto sfora, c'è scrolling verticale scrolla. *@
                    <div class="d-flex flex-column h-100">

                        @* Richiesta form *@
                        @* mb-auto spinge in fondo il contenuto della tabella che viene dopo *@
                        <section class="mb-auto">
                            <form asp-controller="Home" asp-action="CreateNewRequest" method="post">
                                <fieldset>
                                    <header class="my-2">
                                        <legend>Create a new request</legend>
                                    </header>

                                    <article class="mb-2">
                                        <label for="type-request-select" class="form-label">Request type</label>
                                        <select name="EventType" class="form-select" id="type-request-select" v-model="newRequestOption">
                                            <option value="@WorkEventTypeName.HOLIDAY" selected>Holiday</option>
                                            <option value="@WorkEventTypeName.LEAVE">Leave</option>
                                        </select>
                                    </article>

                                    <template v-if="newRequestOption === 'HOLIDAY'">
                                        <article class="mb-2">
                                            <label for="BeginDateRequestHoliday" class="form-label">Begin date</label>
                                            <input type="date" id="BeginDateRequestHoliday" name="BeginDateRequest" class="form-control" v-model="selectedDate" min="@Model.Today.ToString("yyyy-MM-dd")">
                                        </article>
                                        <article class="mb-2">
                                            <label for="EndDateRequestHoliday" class="form-label">End date</label>
                                            <input type="date" id="EndDateRequestHoliday" name="EndDateRequest" class="form-control" :value="selectedDate" min="@Model.Today.ToString("yyyy-MM-dd")">
                                        </article>
                                    </template>
                                    <template v-else>
                                        <article class="mb-2">
                                            <label for="BeginDateRequestLeave" class="form-label">Begin date</label>
                                            <input type="datetime-local" id="BeginDateRequestLeave" name="BeginDateRequest" class="form-control"
                                                   min="@Model.Today.ToString("yyyy-MM-ddT09:00")" v-model="selectedDatetime">
                                        </article>
                                        <article class="mb-2">
                                            <label for="EndDateRequestLeave" class="form-label">End date</label>
                                            <input type="datetime-local" id="EndDateRequestLeave" name="EndDateRequest" class="form-control" :value="selectedDatetime"
                                                   min="@Model.Today.ToString("yyyy-MM-ddT09:00")" :max="maxDateLeave">
                                        </article>
                                    </template>

                                    <article class="mb-2">
                                        <label for="requestNotes" class="form-label">Notes</label>
                                        <textarea id="requestNotes" name="NotesRequest" class="form-control" rows="3" maxlength="100" placeholder="Add a note (optional)"></textarea>
                                    </article>

                                    @Html.HiddenFor(x => x.CalendarViewFilter)
                                    @Html.Hidden("BeginDateSearch", Model.BeginDate)
                                    @Html.Hidden("EndDateSearch", Model.EndDate)
                                    @Html.HiddenFor(x => x.IdEmployee)

                                    <footer class="mb-2">
                                        <input type="submit" value="Send" class="btn btn-primary" />
                                    </footer>
                                </fieldset>
                            </form>
                        </section>

                        @* Con mb-auto di prima, la tabella viene spinta in basso alla pagina *@
                        <section class="table-responsive mt-3" id="voglioLuiInFondo" aria-label="Yearly balances detail">
                            <table class="table table-striped table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th scope="col">Type</th>
                                        <th scope="col">Used</th>
                                        <th scope="col">Accrued</th>
                                        <th scope="col">Available</th>
                                        <th scope="col">Total</th>
                                    </tr>
                                </thead>
                                <tbody class="text-end">
                                    <tr>
                                        <th scope="row" class="text-start">Holiday</th>
                                        <td>@Model.EmployeeTimeOffs.HolidayUsed</td>
                                        <td>@Model.EmployeeTimeOffs.HolidayAccrued</td>
                                        <td>@(Model.EmployeeTimeOffs.HolidayTotal - Model.EmployeeTimeOffs.HolidayUsed)</td>
                                        <td>@Model.EmployeeTimeOffs.HolidayTotal</td>
                                    </tr>
                                    <tr>
                                        <th scope="row" class="text-start">Leave</th>
                                        <td>@Model.EmployeeTimeOffs.LeaveUsed.ToString("F1")</td>
                                        <td>@Model.EmployeeTimeOffs.LeaveAccrued</td>
                                        <td>@((Model.EmployeeTimeOffs.LeaveTotal - Model.EmployeeTimeOffs.LeaveUsed).ToString("F1"))</td>
                                        <td>@Model.EmployeeTimeOffs.LeaveTotal</td>
                                    </tr>
                                </tbody>
                            </table>
                        </section>

                    </div>

                </section>

                @* Remote tab  *@
                <section class="tab-pane fade p-3 table-responsive" id="RemoteTabContent" role="tabpanel">
                    <partial name="_PartialRemoteTab" model="Model" />
                </section>

            </section>
        </section>
    </aside>
</main>


@section scripts {
    <script src="~/js/bundle-vue.js" asp-append-version="true"></script>
    <script>
        const serverModel = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model))

        console.log(serverModel);
    </script>

    <script src="~/js/index.js" asp-append-version="true"></script>
}