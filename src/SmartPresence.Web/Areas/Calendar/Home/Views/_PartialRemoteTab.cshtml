@using SmartPresence.Services.Shared
@using SmartPresence.Web.Areas.Calendar.Home.ViewModel
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model HomeIndexViewModel

@{
}

<table class="table table-bordered text-center align-middle remote-tab-table">
    <thead class="table-dark">
        <tr>
            @foreach (var item in Enumerable.Range(0, 7).Select(x => DateTimeHelper.GetMonday(Model.Today).AddDays(x)))
            {
                <th scope="col" class="@item.ToString("yyyy-MM-dd")">
                    @item.ToString("ddd", System.Globalization.CultureInfo.InvariantCulture)[0].ToString().ToUpper()
                </th>
            }
        </tr>
    </thead>

    <tbody>
        <tr>
            <td class="fw-bold">L</td>
            <td></td>
            <td class="fw-bold">H</td>
            <td class="fw-bold">R</td>
            <td class="fw-bold">R</td>
            <td></td>
            <td></td>
        </tr>
    </tbody>
</table>


<form method="post" class="mt-3" aria-labelledby="saveFormTitle">
    <h2 id="saveFormTitle" class="visually-hidden">Save form</h2>

    <button type="submit" class="btn btn-primary">
        Save
    </button>
</form>


